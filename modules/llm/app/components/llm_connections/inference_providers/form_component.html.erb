<%= component_wrapper(data: wrapper_data) do %>
  <% if replaces_active_provider? %>
    <%= render(Primer::Alpha::Banner.new(scheme: :warning, icon: :alert, mb: 3)) { t("admin.inference_providers.form.replaces_active") } %>
  <% end %>

  <%=
    primer_form_with(
      id: FORM_ID,
      model:,
      scope: :inference_provider,
      url: form_url,
      method: http_method,
      data: { turbo: true }
    ) do |f|
      render(::InferenceProviders::Form.new(f))
    end
  %>

  <%=
    render(
      Primer::Beta::Text.new(
        tag: :div,
        mt: 3,
        hidden: true,
        display: :flex,
        align_items: :center,
        color: :muted,
        data: { "llm--connection-form-target": "progressBanner" }
      )
    ) do
      concat(render(Primer::Beta::Spinner.new(size: :small, mr: 2)))
      concat(t("admin.inference_providers.form.label_connecting"))
    end
  %>
<% end %>
