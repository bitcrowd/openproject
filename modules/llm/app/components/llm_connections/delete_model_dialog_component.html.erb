<% if llm_model.in_use? %>
  <%=
    render(
      Primer::OpenProject::FeedbackDialog.new(
        title: t("admin.llm_models.destroy.title"),
        test_selector: TEST_SELECTOR
      )
    ) do |dialog|
      dialog.with_feedback_message(icon_arguments: { icon: :alert, color: :danger }) do |message|
        message.with_heading(tag: :h2) { t("admin.llm_models.destroy.in_use_heading") }
        message.with_description_content(
          t("admin.llm_models.destroy.in_use", model: llm_model.external_id, uses: llm_model.uses.to_sentence)
        )
      end
    end
  %>
<% else %>
  <%=
    render(
      Primer::OpenProject::DangerDialog.new(
        title: t("admin.llm_models.destroy.title"),
        form_arguments:,
        confirm_button_text: t("admin.llm_models.destroy.title"),
        test_selector: TEST_SELECTOR
      )
    ) do |dialog|
      dialog.with_confirmation_message do |message|
        message.with_heading(tag: :h2) { t("admin.llm_models.destroy.heading", model: llm_model.external_id) }
        message.with_description_content(
          if affected_defaults.any?
            t("admin.llm_models.destroy.description_bound", features: affected_defaults.to_sentence)
          else
            t("admin.llm_models.destroy.description")
          end
        )
      end
    end
  %>
<% end %>
