<%=
  component_wrapper(tag: "turbo-frame", **wrapper_options) do
    if connection.env_changed_since_applied?
      concat(
        render(Primer::Alpha::Banner.new(mb: 3, scheme: :warning, icon: :alert)) do
          t("admin.llm_connections.form.env_changed", time: applied_at)
        end
      )
    elsif connection.configured_from_env?
      concat(
        render(Primer::Alpha::Banner.new(mb: 3, icon: :info)) do
          t("admin.llm_connections.form.env_applied", time: applied_at)
        end
      )
    elsif connection.env_pending?
      concat(
        render(Primer::Alpha::Banner.new(mb: 3, icon: :info)) do
          t("admin.llm_connections.form.env_pending")
        end
      )
    end

    if setup?
      concat(
        settings_primer_form_with(**setup_form_options) do |f|
          render(LlmConnections::SetupForm.new(f, features_enabled:))
        end
      )

      concat(
        render(
          Primer::Beta::Text.new(
            tag: :div,
            mt: 3,
            hidden: true,
            display: :flex,
            align_items: :center,
            color: :muted,
            data: { "llm--connection-form-target": "progressBanner" }
          )
        ) do
          concat(render(Primer::Beta::Spinner.new(size: :small, mr: 2)))
          concat(t("admin.llm_connections.form.label_connecting"))
        end
      )
    else
      concat(
        settings_primer_form_with(**form_options) do |f|
          render(LlmConnections::ConnectionForm.new(f))
        end
      )
    end
  end
%>
